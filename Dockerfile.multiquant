# ============================================================
# vllm-multiquant — Full build from our fork
#
# Source: flash7777/vllm branch multiquant
# Contains: vLLM 0.17 + RIY + MultiQuant + Marlin SM12x + all fixes
#
# No patches, no sed, no build/deps — everything is in the source tree.
# Only external deps: CUTLASS, FlashInfer wheels, MoE configs.
#
# Build (DGX Spark):
#   podman build -f Dockerfile.multiquant -t vllm-multiquant .
#
# Build (RTX PRO 6000 / Spiegel 2):
#   podman build -f Dockerfile.multiquant -t vllm-multiquant \
#     --build-arg CUDA_ARCHS="12.0a"
# ============================================================

ARG BASE_IMAGE=nvcr.io/nvidia/vllm:26.02-py3
FROM ${BASE_IMAGE}

ARG CUDA_ARCHS="12.0a;12.1a"
ARG VLLM_BRANCH=multiquant
ARG MAX_JOBS=16

# ─── System deps ─────────────────────────────────────────────
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends wget libibverbs-dev && \
    ln -sf libibverbs.so.1 /usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH)/libibverbs.so && \
    ARCH_DIR=$(dpkg --print-architecture | sed 's/arm64/sbsa/;s/amd64/x86_64/') && \
    wget -qO /tmp/cuda-keyring.deb \
      "https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/${ARCH_DIR}/cuda-keyring_1.1-1_all.deb" && \
    dpkg -i /tmp/cuda-keyring.deb && rm /tmp/cuda-keyring.deb && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      libcusparse-dev-13-1 libcusolver-dev-13-1 libcufft-dev-13-1 && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir cmake ninja setuptools-scm scipy pytest

# Save NVIDIA's CUDA-aware PyTorch before anything overwrites it
RUN cd /usr/local/lib/python3.12/dist-packages && \
    tar cf /opt/nvidia-torch.tar torch/ $(ls -d torch*.dist-info 2>/dev/null)

# ─── CUTLASS 4.4.0 (SM120a/SM121a) ──────────────────────────
RUN git clone --depth 1 --branch v4.4.0 \
      https://github.com/NVIDIA/cutlass.git /opt/cutlass
ENV VLLM_CUTLASS_SRC_DIR=/opt/cutlass
RUN sed -i '/nvidia-cutlass-dsl/d' /etc/pip/constraint.txt && \
    echo "4.4.0" > /opt/cutlass/python/CuTeDSL/VERSION.EDITABLE && \
    pip install --no-cache-dir --force-reinstall --no-deps /opt/cutlass/python/CuTeDSL

# ─── vLLM from OUR FORK (everything included) ───────────────
RUN git clone --filter=blob:none --branch ${VLLM_BRANCH} \
      https://github.com/flash7777/vllm.git /tmp/vllm-build
WORKDIR /tmp/vllm-build

# Use existing PyTorch, remove flashinfer pin
RUN python use_existing_torch.py
RUN sed -i '/flashinfer-python/d' requirements/cuda.txt 2>/dev/null || true && \
    sed -i '/flashinfer-python/d' pyproject.toml 2>/dev/null || true
RUN pip install --no-cache-dir -r requirements/build.txt

# Remove container's pre-installed vLLM
RUN pip uninstall -y vllm

# Build vLLM from our fork
ENV TORCH_CUDA_ARCH_LIST=${CUDA_ARCHS}
ENV VLLM_TARGET_DEVICE=cuda
ENV MAX_JOBS=${MAX_JOBS}
RUN SETUPTOOLS_SCM_PRETEND_VERSION=0.17.1 pip install --no-build-isolation --no-cache-dir .

# Save our source files that aren't part of pip install
# (multiquant, turboquant, csrc kernels, tests)
RUN cp -r vllm/multiquant /usr/local/lib/python3.12/dist-packages/vllm/multiquant && \
    cp -r vllm/turboquant /usr/local/lib/python3.12/dist-packages/vllm/turboquant && \
    cp -r kernels/turboquant /opt/tq_build && \
    cp -r kernels/archer /opt/archer_build && \
    cp -r tests/multiquant /opt/tests/multiquant && \
    cp -r tests/turboquant /opt/tests/turboquant

WORKDIR /
RUN rm -rf /tmp/vllm-build

# ─── FlashInfer 0.6.6 (prebuilt wheel) ──────────────────────
# Try build context first, then PyPI fallback
COPY build/wheels/flashinfer*.whl /tmp/wheels/ 2>/dev/null || true
RUN if ls /tmp/wheels/flashinfer*.whl 1>/dev/null 2>&1; then \
      echo "Installing FlashInfer from local wheels"; \
      pip install --no-cache-dir --force-reinstall /tmp/wheels/flashinfer*.whl; \
    else \
      echo "No local wheels — installing FlashInfer from PyPI"; \
      pip install --no-cache-dir flashinfer-python==0.6.6; \
    fi && rm -rf /tmp/wheels

# ─── fastsafetensors + Ray ───────────────────────────────────
RUN pip install --no-cache-dir fastsafetensors ray[default] nvidia-nvshmem-cu13
# Restore NVIDIA CUDA torch (pip may have downgraded it)
RUN rm -rf /usr/local/lib/python3.12/dist-packages/torch && \
    tar xf /opt/nvidia-torch.tar -C /usr/local/lib/python3.12/dist-packages/

# ─── transformers 5.x ────────────────────────────────────────
RUN pip install --no-cache-dir --no-deps "transformers>=5.2" && \
    pip install --no-cache-dir --upgrade "huggingface_hub>=0.32" && \
    pip install --no-cache-dir --no-deps "compressed-tensors>=0.13"

# ─── Pre-build TQ CUDA kernel ───────────────────────────────
RUN python3 -c "from torch.utils.cpp_extension import load; \
tq = load(name='tq_serve', \
    sources=['/opt/tq_build/tq_ext.cu', '/opt/tq_build/tq_round_trip.cu'], \
    extra_cuda_cflags=['-O3', '-std=c++17', '--expt-relaxed-constexpr', '--use_fast_math', \
                       '-gencode=arch=compute_121,code=sm_121', '-diag-suppress=177,3288'], \
    extra_include_paths=['/opt/tq_build'], verbose=True); \
print('TQ kernel:', tq)"

# ─── MoE Configs (optional, from build context) ─────────────
COPY build/moe-configs/*.json /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/configs/ 2>/dev/null || true

# ─── Runtime defaults ────────────────────────────────────────
ENV FLASHINFER_CUDA_ARCH_LIST="12.0a 12.1a"
ENV RAY_memory_monitor_refresh_ms=0
ENV RAY_object_store_memory=1073741824

# cv2/typing shadow fix
RUN rm -rf /usr/local/lib/python3.12/dist-packages/cv2/typing 2>/dev/null || true

# ─── Cleanup ─────────────────────────────────────────────────
RUN find /usr/local/lib/python3.12 -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true

# ─── Verify ──────────────────────────────────────────────────
RUN python3 -c "\
import vllm; print('vLLM:', vllm.__version__); \
from vllm.multiquant import is_multiquant_dtype; \
assert is_multiquant_dtype('tq3'); assert is_multiquant_dtype('rq3'); \
print('MultiQuant: tq3 rq3 rq2 tq4 rq4'); \
from vllm.multiquant.weight_quant.config import ArcherConfig; \
print('Archer:', ArcherConfig.get_name()); \
print('All OK')"
