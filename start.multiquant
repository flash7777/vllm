#!/bin/bash
# ============================================================
# MultiQuant Serve — GLM-4.7-Flash mit konfigurierbarem Profil
#
# Nutzung:
#   ./start.multiquant --model GLM-4.7-Flash-int4-AutoRound
#   ./start.multiquant --model GLM-4.7-Flash-FP8 --kv tq4
#   ./start.multiquant --model GLM-4.7-Flash --weights tq3   # BF16 → Archer TQ3
#   ./start.multiquant --model GLM-4.7-Flash-int4-AutoRound --mtp
#   ./start.multiquant --model GLM-4.7-Flash-FP8 --riy /data/tensordata/riy_profile_397b.json
# ============================================================

set -euo pipefail

# ── Defaults ──────────────────────────────────────────────
KV_DTYPE="tq3"
WEIGHTS=""               # tq3 | tq4 | rq3 | rq4 (Archer online-quant, leer=keine)
MODEL_DIR="/data/tensordata"
MODEL=""
MTP=false
RIY_PROFILE=""
TP=1
PORT=8011
SERVED_NAME="glm-4.7-flash"
REASONING_PARSER="glm45"
TOOL_PARSER="glm47"
IMAGE="localhost/vllm-multiquant"
CONTAINER_NAME="mq-serve"
EXTRA_ARGS=()

# ── Argparse ──────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --kv)       KV_DTYPE="$2"; shift 2 ;;
        --weights)  WEIGHTS="$2"; shift 2 ;;
        --model)    MODEL="$2"; shift 2 ;;
        --tp)       TP="$2"; shift 2 ;;
        --mtp)      MTP=true; shift ;;
        --riy)      RIY_PROFILE="$2"; shift 2 ;;
        --served-model-name)  SERVED_NAME="$2"; shift 2 ;;
        --reasoning-parser)  REASONING_PARSER="$2"; shift 2 ;;
        --tool-call-parser)  TOOL_PARSER="$2"; shift 2 ;;
        --port)     PORT="$2"; shift 2 ;;
        --image)    IMAGE="$2"; shift 2 ;;
        --name)     CONTAINER_NAME="$2"; shift 2 ;;
        --eager)    EXTRA_ARGS+=("--enforce-eager"); shift ;;
        --help|-h)
            echo "Nutzung: $0 [Optionen]"
            echo ""
            echo "Optionen:"
            echo "  --kv TYPE        KV-Cache Typ: tq3 tq4 rq2 rq3 rq4 fp8 auto (default: tq3)"
            echo "  --tp N           Tensor Parallelism (default: 1)"
            echo "  --weights TYPE   Archer online-quant: tq3 tq4 rq3 rq4 (leer=keine)"
            echo "  --model PATH     Modell-Pfad oder Name unter $MODEL_DIR/ (pflicht)"
            echo "  --mtp            Multi-Token Prediction aktivieren"
            echo "  --riy FILE       RIY Expert-Profil JSON (MoE Expert Masking)"
            echo "  --served-model-name NAME   API Model-Name (default: glm-4.7-flash)"
            echo "  --reasoning-parser PARSER  Reasoning Parser (default: glm45)"
            echo "  --tool-call-parser PARSER  Tool-Call Parser (default: glm47)"
            echo "  --port PORT                API Port (default: 8011)"
            echo "  --eager                    enforce-eager (kein CUDA Graphs)"
            echo "  --image IMAGE              Container Image (default: localhost/vllm-multiquant)"
            echo "  --name NAME                Container Name (default: mq-serve)"
            exit 0 ;;
        *)
            echo "Unbekannte Option: $1 (--help für Hilfe)"
            exit 1 ;;
    esac
done

# ── Modell-Pfad auflösen ─────────────────────────────────
if [[ -z "$MODEL" ]]; then
    echo "FEHLER: --model ist pflicht."
    echo "Verfügbare Modelle:"
    ls -d "$MODEL_DIR"/GLM-4.7-Flash* "$MODEL_DIR"/Qwen* 2>/dev/null | sed 's|.*/|  |'
    echo ""
    echo "Beispiel: $0 --model GLM-4.7-Flash-int4-AutoRound"
    exit 1
fi

# Absoluter Pfad oder relativ zu MODEL_DIR
if [[ "$MODEL" != /* ]]; then
    MODEL_PATH="$MODEL_DIR/$MODEL"
else
    MODEL_PATH="$MODEL"
fi
MODEL_NAME=$(basename "$MODEL_PATH")

# ── Gewichte-spezifische Flags ────────────────────────────
QUANT_ARGS=()
QUANT_ENV=()

if [[ -n "$WEIGHTS" ]]; then
    # Archer online-quant: BF16/FP8 → compressed at load time
    QUANT_ARGS+=("--quantization" "multiquant")
    QUANT_LABEL="Archer ${WEIGHTS^^}"
else
    QUANT_LABEL="(vom Modell)"
fi

# ── MTP ───────────────────────────────────────────────────
MTP_LABEL="aus"
if $MTP; then
    EXTRA_ARGS+=("--num-speculative-tokens" "1")
    EXTRA_ARGS+=("--speculative-model" "[ngram]")
    MTP_LABEL="an (ngram, 1 token)"
fi

# ── RIY ───────────────────────────────────────────────────
RIY_LABEL="aus"
if [[ -n "$RIY_PROFILE" ]]; then
    if [[ ! -f "$RIY_PROFILE" ]]; then
        echo "FEHLER: RIY Profil nicht gefunden: $RIY_PROFILE"
        echo "Verfügbare Profile:"
        ls /data/tensordata/riy_profile*.json 2>/dev/null | sed 's|.*/|  |'
        exit 1
    fi
    EXTRA_ARGS+=("--riy-expert-profile" "$RIY_PROFILE")
    RIY_LABEL=$(basename "$RIY_PROFILE")
fi

# ── Banner ────────────────────────────────────────────────
printf "╔══════════════════════════════════════════════════════╗\n"
printf "║  MultiQuant Serve                                    ║\n"
printf "╠══════════════════════════════════════════════════════╣\n"
printf "║  Modell:   %-40s ║\n" "$MODEL_NAME"
printf "║  Gewichte: %-40s ║\n" "$QUANT_LABEL"
printf "║  KV-Cache: %-40s ║\n" "$KV_DTYPE"
printf "║  TP:       %-40s ║\n" "$TP"
printf "║  MTP:      %-40s ║\n" "$MTP_LABEL"
printf "║  RIY:      %-40s ║\n" "$RIY_LABEL"
printf "║  Port:     %-40s ║\n" "$PORT"
printf "╚══════════════════════════════════════════════════════╝\n"
echo ""

# ── Prüfungen ────────────────────────────────────────────
if ! podman image exists "$IMAGE"; then
    echo "FEHLER: Image '$IMAGE' nicht gefunden."
    echo "Bauen mit: podman build -f Dockerfile.multiquant -t vllm-multiquant ."
    exit 1
fi

if [[ ! -d "$MODEL_PATH" ]]; then
    echo "FEHLER: Modell nicht gefunden: $MODEL_PATH"
    echo "Verfügbare Modelle:"
    ls -d "$MODEL_DIR"/GLM-4.7-Flash* 2>/dev/null | sed 's|.*/|  |'
    exit 1
fi

# Vorherigen Container stoppen
podman stop "$CONTAINER_NAME" 2>/dev/null || true
podman rm "$CONTAINER_NAME" 2>/dev/null || true

# ── Container starten ────────────────────────────────────
podman run -d \
  --replace \
  --name "$CONTAINER_NAME" \
  --device nvidia.com/gpu=all \
  --security-opt=label=disable \
  --hooks-dir=/usr/share/containers/oci/hooks.d \
  --log-driver=k8s-file \
  --log-opt path=/data/tensordata/logs/mq-serve.log \
  --ipc=host \
  --network host \
  -v /data/tensordata:/data/tensordata \
  -v "$HOME/.cache/huggingface:/root/.cache/huggingface" \
  -e VLLM_MLA_DISABLE=1 \
  -e VLLM_WORKER_MULTIPROC_METHOD=fork \
  -e FLASHINFER_DISABLE_VERSION_CHECK=1 \
  -e FLASHINFER_DISABLE_AUTOTUNER=1 \
  -e VLLM_DISABLED_KERNELS=CutlassFP8ScaledMMLinearKernel \
  -e FLASHINFER_CUDA_ARCH_LIST="12.0a 12.1a" \
  "${QUANT_ENV[@]}" \
  "$IMAGE" \
  vllm serve "$MODEL_PATH" \
    --host 0.0.0.0 \
    --port "$PORT" \
    --served-model-name "$SERVED_NAME" \
    --tensor-parallel-size "$TP" \
    --gpu-memory-utilization 0.90 \
    --max-model-len 100000 \
    --kv-cache-dtype "$KV_DTYPE" \
    --tool-call-parser "$TOOL_PARSER" \
    --reasoning-parser "$REASONING_PARSER" \
    --enable-auto-tool-choice \
    --disable-log-requests \
    --trust-remote-code \
    "${QUANT_ARGS[@]}" \
    "${EXTRA_ARGS[@]}"

echo ""
echo "Container '$CONTAINER_NAME' gestartet."
echo ""
echo "  Logs:     podman logs -f $CONTAINER_NAME"
echo "  API:      http://localhost:$PORT/v1/chat/completions"
echo "  Stoppen:  podman stop $CONTAINER_NAME"
echo ""
echo "  Beispiele:"
echo "    ./start.multiquant --model GLM-4.7-Flash-int4-AutoRound"
echo "    ./start.multiquant --model GLM-4.7-Flash-FP8 --kv tq4"
echo "    ./start.multiquant --model GLM-4.7-Flash --weights tq3"
echo "    ./start.multiquant --model GLM-4.7-Flash-int4-AutoRound --mtp"
echo "    ./start.multiquant --model GLM-4.7-Flash-FP8 --riy /data/tensordata/riy_profile_397b.json"
