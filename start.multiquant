#!/bin/bash
# ============================================================
# MultiQuant Serve — GLM-4.7-Flash mit konfigurierbarem Profil
#
# Nutzung:
#   ./start.multiquant --model GLM-4.7-Flash-int4-AutoRound
#   ./start.multiquant --model GLM-4.7-Flash-FP8 --kv tq4
#   ./start.multiquant --model GLM-4.7-Flash --weights tq3   # BF16 → Archer TQ3
#   ./start.multiquant --model GLM-4.7-Flash-int4-AutoRound --mtp
#   ./start.multiquant --model GLM-4.7-Flash-FP8 --riy /data/tensordata/riy_profile_397b.json
# ============================================================

set -euo pipefail

# ── Defaults ──────────────────────────────────────────────
KV_DTYPE="tq3w"   # Always use Walsh-Hadamard variant; plain tq3/tq4 are math-broken.
WEIGHTS=""               # tq3 | tq4 | rq3 | rq4 (Archer online-quant, leer=keine)
ROUTED=""                # Per-class: int2 int3 int4 tq3 tq4 rq3 rq4 (leer=vom Modell)
SHARED=""                # Per-class: bf16 int4 (leer=vom Modell)
ATTN=""                  # Per-class: int4 bf16 (leer=vom Modell)
WMTP=""                  # Per-class: bf16 int4 (leer=bf16)
WDTYPE=""                # Global: xfp xfp2 xfp3 xfp4 fp8 (überschreibt Per-Class)
WLMHEAD=""               # LM Head / Embedding: fp8 (leer=bf16)
MODEL_DIR="/data/tensordata"
MODEL=""
MTP=false
SPEC_TOKENS=0             # Speculative draft tokens (0 = disabled). nst=3 typical for ngram.
SPEC_METHOD="ngram"        # ngram | eagle | eagle3 | medusa | mlp_speculator
SPEC_PROMPT_LOOKUP_MAX=4
SPEC_PROMPT_LOOKUP_MIN=2
RIY_PROFILE=""
TP=1
PORT=8011
SERVED_NAME="glm-4.7-flash"
REASONING_PARSER=""
TOOL_PARSER=""
MAX_MODEL_LEN=32768
# Auto-detect: GB10 Unified Memory needs very low util — the CUDA profiler
# lies on UMA (reports <9 GiB free regardless of actual), so anything above
# ~0.05 causes vLLM to reserve phantom memory and OOM during BF16 load.
# Companion: kv_cache_memory_bytes must be set explicitly when util is tiny.
if nvidia-smi --query-gpu=memory.total --format=csv,noheader 2>/dev/null | grep -q "N/A\|Not Supported"; then
    GPU_MEM_UTIL=0.05   # GB10 UMA: force vLLM to skip profiler, rely on KV bytes
    KV_CACHE_MEM_DEFAULT="10G"
else
    GPU_MEM_UTIL=0.95   # Discrete GPU (RTX, A100, etc.)
    KV_CACHE_MEM_DEFAULT=""
fi
KV_CACHE_MEM="$KV_CACHE_MEM_DEFAULT"
IMAGE="localhost/vllm-multiquant"
CONTAINER_NAME="mq-serve"
CACHE_DIR="/data/tensordata/mq-cache"
CACHE_READ_ONLY=false
EXTRA_ARGS=()

# ── Argparse ──────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --kv)       KV_DTYPE="$2"; shift 2 ;;
        --weights)  WEIGHTS="$2"; shift 2 ;;
        --routed)   ROUTED="$2"; shift 2 ;;
        --shared)   SHARED="$2"; shift 2 ;;
        --attn)     ATTN="$2"; shift 2 ;;
        --wmtp)     WMTP="$2"; shift 2 ;;
        --weight-dtype) WDTYPE="$2"; shift 2 ;;
        --weight-dtype-lm-head) WLMHEAD="$2"; shift 2 ;;
        --model)    MODEL="$2"; shift 2 ;;
        --tp)       TP="$2"; shift 2 ;;
        --mtp)      MTP=true; shift ;;
        --spec)     SPEC_TOKENS="$2"; shift 2 ;;
        --spec-method) SPEC_METHOD="$2"; shift 2 ;;
        --spec-lookup-max) SPEC_PROMPT_LOOKUP_MAX="$2"; shift 2 ;;
        --spec-lookup-min) SPEC_PROMPT_LOOKUP_MIN="$2"; shift 2 ;;
        --riy)      RIY_PROFILE="$2"; shift 2 ;;
        --nvtx)     EXTRA_ARGS+=("--enable-layerwise-nvtx-tracing"); shift ;;
        --profile)  EXTRA_ARGS+=("--profiler-config" "{\"profiler\":\"torch\",\"torch_profiler_dir\":\"/measurements\",\"active_iterations\":20,\"warmup_iterations\":2}"); shift ;;
        --served-model-name)    SERVED_NAME="$2"; shift 2 ;;
        --reasoning-parser)    REASONING_PARSER="$2"; shift 2 ;;
        --tool-call-parser)    TOOL_PARSER="$2"; shift 2 ;;
        --max-model-len)       MAX_MODEL_LEN="$2"; shift 2 ;;
        --gpu-memory-utilization) GPU_MEM_UTIL="$2"; shift 2 ;;
        --kv-cache-memory-bytes) KV_CACHE_MEM="$2"; shift 2 ;;
        --port)     PORT="$2"; shift 2 ;;
        --image)    IMAGE="$2"; shift 2 ;;
        --name)     CONTAINER_NAME="$2"; shift 2 ;;
        --cache-dir)   CACHE_DIR="$2"; shift 2 ;;
        --no-cache)    CACHE_DIR=""; shift ;;
        --cache-ro)    CACHE_READ_ONLY=true; shift ;;
        --eager)    EXTRA_ARGS+=("--enforce-eager"); shift ;;
        --help|-h)
            echo "Nutzung: $0 [Optionen]"
            echo ""
            echo "Optionen:"
            echo "  --kv TYPE        KV-Cache Typ: tq3 tq4 rq2 rq3 rq4 fp8 (default: tq3)"
            echo "  --tp N           Tensor Parallelism (default: 1)"
            echo "  --weights TYPE   Archer online-quant: tq3 tq4 rq3 rq4 (leer=keine)"
            echo ""
            echo "  Per-Class Gewichte (RTN quant-on-load, nur fuer BF16-Modelle):"
            echo "  --routed TYPE    Routed Experts: int2 int3 int4 (leer=vom Modell)"
            echo "  --shared TYPE    Shared Experts: bf16 int4 (leer=vom Modell)"
            echo "  --attn TYPE      Attention: int4 bf16 (leer=vom Modell)"
            echo "  --wmtp TYPE      MTP Layers: bf16 int4 (leer=bf16)"
            echo "  --weight-dtype TYPE            Global: xfp xfp2 xfp3 xfp4 fp8"
            echo "  --weight-dtype-lm-head TYPE    LM Head/Embedding: fp8 (leer=bf16)"
            echo "  --model PATH     Modell-Pfad oder Name unter $MODEL_DIR/ (pflicht)"
            echo "  --mtp            Multi-Token Prediction aktivieren"
            echo "  --riy FILE       RIY Expert-Profil JSON (MoE Expert Masking)"
            echo "  --max-model-len N          Max Kontext-Länge (default: 100000)"
            echo "  --gpu-memory-utilization F GPU Memory Fraction (default: 0.05, GB10 Unified)"
            echo "  --kv-cache-memory-bytes N  KV-Cache Speicher, z.B. 10G (default: auto)"
            echo "  --served-model-name NAME   API Model-Name (default: glm-4.7-flash)"
            echo "  --reasoning-parser PARSER  Reasoning Parser (optional, z.B. glm45)"
            echo "  --tool-call-parser PARSER  Tool-Call Parser (optional, z.B. glm47)"
            echo "  --port PORT                API Port (default: 8011)"
            echo "  --eager                    enforce-eager (kein CUDA Graphs)"
            echo "  --image IMAGE              Container Image (default: localhost/vllm-multiquant)"
            echo "  --name NAME                Container Name (default: mq-serve)"
            exit 0 ;;
        *)
            echo "Unbekannte Option: $1 (--help für Hilfe)"
            exit 1 ;;
    esac
done

# ── Modell-Pfad auflösen ─────────────────────────────────
if [[ -z "$MODEL" ]]; then
    echo "FEHLER: --model ist pflicht."
    echo "Verfügbare Modelle:"
    ls -d "$MODEL_DIR"/GLM-4.7-Flash* "$MODEL_DIR"/Qwen* 2>/dev/null | sed 's|.*/|  |'
    echo ""
    echo "Beispiel: $0 --model GLM-4.7-Flash-int4-AutoRound"
    exit 1
fi

# Absoluter Pfad oder relativ zu MODEL_DIR
if [[ "$MODEL" != /* ]]; then
    MODEL_PATH="$MODEL_DIR/$MODEL"
else
    MODEL_PATH="$MODEL"
fi
MODEL_NAME=$(basename "$MODEL_PATH")

# ── Gewichte-spezifische Flags ────────────────────────────
QUANT_ARGS=()
QUANT_ENV=()

# Determine if any RTN quantization is requested
_ANY_RTN=false
[[ -n "$WEIGHTS" || -n "$ROUTED" || -n "$SHARED" || -n "$ATTN" || -n "$WMTP" || -n "$WDTYPE" || -n "$WLMHEAD" ]] && _ANY_RTN=true

if [[ -n "$WEIGHTS" ]]; then
    # Archer online-quant: BF16/FP8 → compressed at load time
    QUANT_ARGS+=("--quantization" "multiquant")
    QUANT_LABEL="Archer ${WEIGHTS^^}"
elif $_ANY_RTN; then
    # Per-class RTN: BF16 → GPTQ at load time
    QUANT_ARGS+=("--quantization" "autoround_rtn")
    QUANT_LABEL="RTN per-class"
else
    QUANT_LABEL="(vom Modell)"
fi

# Global weight dtype override (xfp, xfp2, xfp3, xfp4, fp8)
[[ -n "$WDTYPE" ]]  && QUANT_ARGS+=("--weight-dtype" "$WDTYPE")
[[ -n "$WLMHEAD" ]] && QUANT_ARGS+=("--weight-dtype-lm-head" "$WLMHEAD")
# Per-class weight dtype overrides
[[ -n "$ROUTED" ]] && QUANT_ARGS+=("--weight-dtype-routed" "$ROUTED")
[[ -n "$SHARED" ]] && QUANT_ARGS+=("--weight-dtype-shared" "$SHARED")
[[ -n "$ATTN" ]]   && QUANT_ARGS+=("--weight-dtype-attn" "$ATTN")
[[ -n "$WMTP" ]]   && QUANT_ARGS+=("--weight-dtype-mtp" "$WMTP")

# ── Speculative decoding (MTP / ngram / eagle) ─────────────
# Legacy: --mtp implies nst=1 ngram. New: --spec N --spec-method M (vLLM 0.17+)
MTP_LABEL="aus"
if $MTP && [[ "$SPEC_TOKENS" == "0" ]]; then
    SPEC_TOKENS=1
    SPEC_METHOD="ngram"
fi
if [[ "$SPEC_TOKENS" != "0" ]] && [[ -n "$SPEC_TOKENS" ]]; then
    # vLLM 0.17+ --speculative-config JSON
    if [[ "$SPEC_METHOD" == "ngram" ]]; then
        SPEC_JSON="{\"method\":\"ngram\",\"num_speculative_tokens\":$SPEC_TOKENS,\"prompt_lookup_max\":$SPEC_PROMPT_LOOKUP_MAX,\"prompt_lookup_min\":$SPEC_PROMPT_LOOKUP_MIN}"
    else
        SPEC_JSON="{\"method\":\"$SPEC_METHOD\",\"num_speculative_tokens\":$SPEC_TOKENS}"
    fi
    EXTRA_ARGS+=("--speculative-config" "$SPEC_JSON")
    MTP_LABEL="an ($SPEC_METHOD, $SPEC_TOKENS tokens)"
fi

# ── RIY ───────────────────────────────────────────────────
RIY_LABEL="aus"
if [[ -n "$RIY_PROFILE" ]]; then
    if [[ ! -f "$RIY_PROFILE" ]]; then
        echo "FEHLER: RIY Profil nicht gefunden: $RIY_PROFILE"
        echo "Verfügbare Profile:"
        ls /data/tensordata/riy_profile*.json 2>/dev/null | sed 's|.*/|  |'
        exit 1
    fi
    EXTRA_ARGS+=("--riy-expert-profile" "$RIY_PROFILE")
    RIY_LABEL=$(basename "$RIY_PROFILE")
fi

# ── KV Cache Memory ──────────────────────────────────────
if [[ -n "$KV_CACHE_MEM" ]]; then
    EXTRA_ARGS+=("--kv-cache-memory-bytes" "$KV_CACHE_MEM")
fi

# ── Parsers (only if explicitly set) ────────────────────
if [[ -n "$TOOL_PARSER" ]]; then
    EXTRA_ARGS+=("--tool-call-parser" "$TOOL_PARSER" "--enable-auto-tool-choice")
fi
if [[ -n "$REASONING_PARSER" ]]; then
    EXTRA_ARGS+=("--reasoning-parser" "$REASONING_PARSER")
fi

# ── Banner ────────────────────────────────────────────────
printf "╔══════════════════════════════════════════════════════╗\n"
printf "║  MultiQuant Serve                                    ║\n"
printf "╠══════════════════════════════════════════════════════╣\n"
printf "║  Modell:   %-40s ║\n" "$MODEL_NAME"
printf "║  Gewichte: %-40s ║\n" "$QUANT_LABEL"
if $_ANY_RTN && [[ -z "$WEIGHTS" ]]; then
printf "║    Routed: %-40s ║\n" "${ROUTED:-vom Modell}"
printf "║    Shared: %-40s ║\n" "${SHARED:-vom Modell}"
printf "║    Attn:   %-40s ║\n" "${ATTN:-vom Modell}"
printf "║    MTP:    %-40s ║\n" "${WMTP:-bf16}"
fi
printf "║  KV-Cache: %-40s ║\n" "$KV_DTYPE"
printf "║  TP:       %-40s ║\n" "$TP"
printf "║  MTP:      %-40s ║\n" "$MTP_LABEL"
printf "║  RIY:      %-40s ║\n" "$RIY_LABEL"
printf "║  Port:     %-40s ║\n" "$PORT"
if [[ -n "$CACHE_DIR" ]]; then
    _cache_label="$CACHE_DIR"
    $CACHE_READ_ONLY && _cache_label="$_cache_label (ro)"
else
    _cache_label="disabled"
fi
printf "║  Cache:    %-40s ║\n" "$_cache_label"
printf "╚══════════════════════════════════════════════════════╝\n"

# Cache env array (only set if cache is enabled)
CACHE_ENV=()
if [[ -n "$CACHE_DIR" ]]; then
    mkdir -p "$CACHE_DIR" 2>/dev/null || true
    CACHE_ENV+=("-e" "MULTIQUANT_CACHE_DIR=$CACHE_DIR")
    if $CACHE_READ_ONLY; then
        CACHE_ENV+=("-e" "MULTIQUANT_CACHE_READ_ONLY=1")
    fi
fi
echo ""

# ── Prüfungen ────────────────────────────────────────────
if ! podman image exists "$IMAGE"; then
    echo "FEHLER: Image '$IMAGE' nicht gefunden."
    echo "Bauen mit: podman build -f Dockerfile.multiquant -t vllm-multiquant ."
    exit 1
fi

if [[ ! -d "$MODEL_PATH" ]]; then
    echo "FEHLER: Modell nicht gefunden: $MODEL_PATH"
    echo "Verfügbare Modelle:"
    ls -d "$MODEL_DIR"/GLM-4.7-Flash* 2>/dev/null | sed 's|.*/|  |'
    exit 1
fi

# Vorherigen Container stoppen
podman stop "$CONTAINER_NAME" 2>/dev/null || true
podman rm "$CONTAINER_NAME" 2>/dev/null || true

# ── Container starten ────────────────────────────────────
podman run -d \
  --replace \
  --name "$CONTAINER_NAME" \
  --device nvidia.com/gpu=all \
  --security-opt=label=disable \
  --hooks-dir=/usr/share/containers/oci/hooks.d \
  --log-driver=k8s-file \
  --log-opt path=/data/tensordata/logs/mq-serve.log \
  --ipc=host \
  --network host \
  -v /data/tensordata:/data/tensordata \
  -v "$HOME/.cache/huggingface:/root/.cache/huggingface" \
  -v "$HOME/vllm-riy/measurements:/measurements:rw" \
  -v "$HOME/vllm-riy/kernels/multiquant:/opt/mq_kernels:ro" \
  -v "$HOME/vllm-riy/vllm/multiquant:/usr/local/lib/python3.12/dist-packages/vllm/multiquant:ro" \
  -v "$HOME/vllm-riy/vllm/v1/executor/uniproc_executor.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/executor/uniproc_executor.py:ro" \
  -v "$HOME/vllm-riy/vllm/v1/worker/gpu_worker.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu_worker.py:ro" \
  -v "$HOME/vllm-riy/vllm/model_executor/models/qwen3_5.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/qwen3_5.py:ro" \
  -v "$HOME/vllm-riy/vllm/model_executor/models/qwen3_next.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/qwen3_next.py:ro" \
  -v "$HOME/vllm-riy/vllm/model_executor/models/qwen3_5_mtp.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/qwen3_5_mtp.py:ro" \
  -v "$HOME/vllm-riy/vllm/model_executor/layers/fused_moe/fused_marlin_moe.py:/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/fused_marlin_moe.py:ro" \
  -e VLLM_MLA_DISABLE=1 \
  -e VLLM_WORKER_MULTIPROC_METHOD=fork \
  -e FLASHINFER_DISABLE_VERSION_CHECK=1 \
  -e FLASHINFER_DISABLE_AUTOTUNER=1 \
  -e VLLM_DISABLED_KERNELS=CutlassFP8ScaledMMLinearKernel \
  -e FLASHINFER_CUDA_ARCH_LIST="12.0a 12.1a" \
  ${VLLM_NVTX_PROFILE:+-e VLLM_NVTX_PROFILE="${VLLM_NVTX_PROFILE}"} \
  "${CACHE_ENV[@]}" \
  "${QUANT_ENV[@]}" \
  "$IMAGE" \
  vllm serve "$MODEL_PATH" \
    --host 0.0.0.0 \
    --port "$PORT" \
    --served-model-name "$SERVED_NAME" \
    --tensor-parallel-size "$TP" \
    --gpu-memory-utilization "$GPU_MEM_UTIL" \
    --max-model-len "$MAX_MODEL_LEN" \
    --kv-cache-dtype "$KV_DTYPE" \
    --trust-remote-code \
    "${QUANT_ARGS[@]}" \
    "${EXTRA_ARGS[@]}"

echo ""
echo "Container '$CONTAINER_NAME' gestartet."
echo ""
echo "  Logs:     podman logs -f $CONTAINER_NAME"
echo "  API:      http://localhost:$PORT/v1/chat/completions"
echo "  Stoppen:  podman stop $CONTAINER_NAME"
echo ""
echo "  Beispiele (Qwen 3.5 MoE Referenzen — alle mit fp8 KV + fp8 LM-head):"
echo "    ./start.multiquant --model Qwen3.5-122B-A10B --weight-dtype xfp --kv fp8 --weight-dtype-lm-head fp8"
echo "    ./start.multiquant --model Qwen3.5-122B-A10B-int4-AutoRound --kv fp8 --weight-dtype-lm-head fp8"
echo "    ./start.multiquant --model Qwen3.5-122B-A10B-GPTQ-Int4 --kv fp8 --weight-dtype-lm-head fp8"
echo "    ./start.multiquant --model Qwen3.5-397B-A17B-int4-AutoRound --kv fp8 --weight-dtype-lm-head fp8 --riy /data/tensordata/riy_profile_397b_24pct.json --tp 2"
